{
  "manifest_version": 2,
  "name": "UWords",
  "version": "1.2.1",
  "description": "Click a word to see its Cambridge Dictionary and Merriam-Webster definitions (including Simple Definitions) in a small popup. Works in YouTube captions and PDFs too.",
  "browser_specific_settings": {
    "gecko": {
      "id": "uwords@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
  "background": {
    "scripts": [
      "common/settings.js",
      "background/dom-utils.js",
      "background/parse-cambridge.js",
      "background/parse-merriam.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common/settings.js", "ui/panel.js", "content/content.js", "content/youtube.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "UWords",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "web_accessible_resources": ["ui/panel.css", "pdfjs/web/uwords-viewer.html"]
}
